# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# LLM Service Configuration
LLM_API_BASE_URL=http://localhost:1234
LLM_API_KEY=

# Cache Configuration (optional)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Webhook Configuration (optional, for production)
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration
DB_HOST=localhost
DB_PORT=1235
DB_NAME=db
DB_USER=user
DB_PASSWORD=password
DB_MAX_CONNECTIONS=10

# Embedding Provider Configuration
EMBEDDING_API_BASE_URL=http://localhost:1234
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=

# Admin Configuration (optional)
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# Proxy Configuration (optional)
# Формат: http://host:port или http://user:password@host:port
PROXY_URL=http://proxy.example.com:8080

# Analytics Configuration
YANDEX_METRIKA_COUNTER_ID=your_counter_id_here
YANDEX_METRIKA_MS=your_measurement_protocol_token